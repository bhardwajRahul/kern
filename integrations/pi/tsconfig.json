{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "index.ts",
    "pure.ts",
    "harness.ts",
    "test.ts",
    "test-edge.ts",
    "test-hostile.ts",
    "test-pure.ts",
    "test-register.ts"
  ]
}
